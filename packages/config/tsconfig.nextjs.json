{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,

    "plugins": [{ "name": "next" }]
  }
}
