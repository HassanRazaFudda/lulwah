{
  "name": "@lulwah/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tooling presets — tsconfig, ESLint, Prettier, Tailwind — so every app and package configures itself the same way (plan.md §6).",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.nextjs.json": "./tsconfig.nextjs.json",
    "./eslint.config.js": "./eslint.config.js",
    "./prettier.config.js": "./prettier.config.js",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "default": "./dist/tailwind-preset.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lulwah/tokens": "workspace:*",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0"
  }
}
