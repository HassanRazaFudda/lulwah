{
  "name": "@lulwah/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas + inferred TS types — the single shared source of truth between the API, storefront and admin (plan.md §6.1).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lulwah/config": "workspace:*",
    "eslint": "^10.8.1",
    "typescript": "^6.0.0"
  }
}
