# .env.example — Lulwah Fashion
#
# Copy this to `.env` for local development (docker-compose.dev.yml + `pnpm dev`
# on the host). Never commit the real `.env` — it's gitignored.
#
# In production this same variable list lives at /srv/lulwah/.env (mode 600,
# root-owned, never in git — see plan.md §25.3) plus a parallel
# /srv/lulwah/.env.staging with staging-scoped values (separate db name,
# redis db index, meili prefix — see plan.md §25.1). Both are backed up
# encrypted via restic; a copy of the real values lives in the client's
# password manager.
#
# Every value below is a placeholder/dummy. Every variable is re-validated
# through a Zod schema at container boot (config/env.ts) — a missing or
# malformed value crashes the container at startup rather than at 2am during
# a sale, and because the container then fails its healthcheck, a rolling
# deploy stops automatically and the previous version keeps serving.

# ============================================================================
# Shared / infrastructure
# ============================================================================

NODE_ENV=development
TZ=UTC

DOMAIN=lulwah.ae
# Let's Encrypt account email — Caddy uses this for ACME registration/renewal notices.
ACME_EMAIL=devops@lulwah.ae

# `replicaSet=rs0` is required, not optional: order placement runs a
# multi-document transaction (create order -> decrement stock -> increment
# discount usage, all-or-nothing) and a standalone mongod cannot run
# transactions at all. `directConnection=true` is needed because this is a
# single-node replica set with no other members to discover. See plan.md §36.6.
#
# These values are the LOCAL DEV shape: web/admin/api run on the host via
# `pnpm dev` (see docker-compose.dev.yml), not inside the Compose network, so
# they must reach Mongo/Redis/Meilisearch via 127.0.0.1 + the published host
# port, not the Docker-internal service name. Mongo is on host port 27018
# (not the default 27017) specifically so it doesn't collide with a plain
# local `mongod` a developer may already have running unrelated to this
# project — that instance is almost certainly not a replica set, so it can't
# be reused for this app regardless of port. In PRODUCTION, web/admin/api run
# as containers on the same Compose network as Mongo/Redis/Meilisearch, so
# those `.env` values instead use the service names directly, e.g.
# `mongodb://mongo:27017/...`, `redis://...@redis:6379/0`, `http://meilisearch:7700`.
MONGODB_URI=mongodb://127.0.0.1:27018/lulwah_dev?replicaSet=rs0&directConnection=true
MONGO_ROOT_USER=lulwah_root
MONGO_ROOT_PASSWORD=change-me-mongo-root-password

# `redis://:PASS@host:port/DB` — the DB index separates prod (0) from
# staging (1) on the same Redis daemon, since both share one process to save
# RAM on the 8 GB VPS (plan.md §25.1). Dev Redis is on host port 6380 (not
# the default 6379) so it doesn't collide with an unrelated project's Redis
# a developer may already have running locally — same reasoning as Mongo's
# 27018 above. In production this reverts to the standard 6379 inside the
# Compose network (service name `redis`, no port conflict possible there).
REDIS_URL=redis://:devpassword@127.0.0.1:6380/0
REDIS_PASSWORD=devpassword

MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-meili-master-key-min-16-bytes
# Index name prefix, not a separate instance — staging and prod share one
# Meilisearch daemon to save RAM; the prefix is what keeps their indexes apart.
MEILI_INDEX_PREFIX=dev_

# S3-compatible object storage (Contabo Object Storage / Backblaze B2) — media
# originals and restic backup target, never local disk (plan.md §36.8).
S3_ENDPOINT=https://usc1.contabostorage.com
S3_REGION=us-central-1
S3_BUCKET=lulwah-media-dev
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_PUBLIC_BASE_URL=https://media.lulwah.ae

# Signs imgproxy URLs so image transforms can't be abused as an open proxy —
# see plan.md §36.10 gotcha #13 and §36.12 checklist ("unsigned URL returns 403").
IMGPROXY_KEY=change-me-imgproxy-hex-key
IMGPROXY_SALT=change-me-imgproxy-hex-salt
IMGPROXY_BASE_URL=http://imgproxy:8080

# Pull-only PAT for `docker compose pull` against ghcr.io — never a
# push-capable token on the server (images are only ever built in CI).
GHCR_TOKEN=change-me-ghcr-pull-only-pat

# restic encrypts nightly mongodump + Meili dump + .env backups before they
# leave the box (plan.md §36.8). B2 is the off-box target in the given example;
# swap for Contabo Object Storage creds if that's the chosen backend instead.
RESTIC_REPOSITORY=b2:lulwah-backups:restic
RESTIC_PASSWORD=change-me-restic-repo-password
B2_ACCOUNT_ID=change-me-b2-account-id
B2_ACCOUNT_KEY=change-me-b2-account-key

# Scoped to cache-purge only — used by deploy.sh to purge by Cache-Tag after
# a release, not a full-access API token.
CLOUDFLARE_ZONE_ID=change-me-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=change-me-cloudflare-purge-scoped-token

# Not enumerated in plan.md §25.3's list, but required by caddy/Caddyfile's
# `basic_auth` block on the staging vhosts — added here so the compose
# stack is actually runnable. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# IMPORTANT: a bcrypt hash is full of literal `$` characters, and Docker
# Compose's .env parser treats `$word` as a variable reference to expand —
# every `$` below MUST be doubled to `$$`, or the hash gets silently
# truncated at the first `$word`-shaped segment (e.g. `$2a$14$abc...`
# quietly loses everything from `$abc` onward, and basic_auth then rejects
# every password). Verify with `docker compose config` and confirm the
# value round-trips unchanged.
STAGING_BCRYPT_HASH=$$2a$$14$$change.me.to.a.real.bcrypt.hash.generated.by.caddy

# ============================================================================
# apps/api
# ============================================================================

PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

JWT_ACCESS_SECRET=change-me-jwt-access-secret-32-bytes-min
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-32-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Leading dot shares the cookie across web/admin/api subdomains; must be
# false in local dev (no HTTPS on localhost) and true in staging/production.
COOKIE_DOMAIN=.lulwah.ae
COOKIE_SECURE=false

# Argon2id tuning — memory in KiB. See plan.md §19 for the rationale; do not
# lower these without re-reading that section.
ARGON2_MEMORY=19456
ARGON2_TIME=2

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me

TABBY_SECRET_KEY=change-me-tabby-secret-key
TABBY_PUBLIC_KEY=change-me-tabby-public-key
TABBY_WEBHOOK_SECRET=change-me-tabby-webhook-secret

TAMARA_API_TOKEN=change-me-tamara-api-token
TAMARA_NOTIFICATION_TOKEN=change-me-tamara-notification-token

# Resend, not self-hosted SMTP — Contabo IP ranges have poor deliverability
# reputation and port 25 is frequently blocked outright. See plan.md §36.10
# gotcha #7.
RESEND_API_KEY=re_change_me
EMAIL_FROM="Lulwah Fashion <orders@lulwah.ae>"
EMAIL_REPLY_TO=support@lulwah.ae

UNIFONIC_APP_SID=change-me-unifonic-app-sid
UNIFONIC_SENDER_ID=LULWAH
WHATSAPP_PHONE_ID=change-me-whatsapp-phone-id
WHATSAPP_TOKEN=change-me-whatsapp-token

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-client-secret

ARAMEX_USERNAME=change-me-aramex-username
ARAMEX_PASSWORD=change-me-aramex-password
ARAMEX_ACCOUNT_NUMBER=change-me-aramex-account-number
ARAMEX_ACCOUNT_PIN=change-me-aramex-account-pin
ARAMEX_ENTITY=DXB

SENTRY_DSN=https://change-me@o0.ingest.sentry.io/0
LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Money is always in fils (1 AED = 100 fils) per plan.md §27.2 naming
# convention — never store or compare floats for currency.
VAT_RATE=0.05
FREE_SHIPPING_THRESHOLD_FILS=30000
COD_FEE_FILS=1000
COD_MAX_ORDER_FILS=200000

STORE_TRN=100000000000003
STORE_NAME="Lulwah Fashion"
STORE_EMAIL=support@lulwah.ae
STORE_PHONE=+971500000000
STORE_WHATSAPP=+971500000000

# The api and worker containers run the same image; this flag is what
# switches server.ts vs worker.ts behavior — set true only by the worker
# service/container, never in a shared default.
WORKER=false

# ============================================================================
# apps/web
# ============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side (RSC) calls hit the api container directly on the Docker
# network — using the public URL here would round-trip every server render
# through Cloudflare and back, adding 200-400ms for nothing. See plan.md §36.7.
API_INTERNAL_URL=http://api:4000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
NEXT_PUBLIC_TABBY_PUBLIC_KEY=change-me-tabby-public-key
NEXT_PUBLIC_IMGPROXY_BASE_URL=http://localhost:8080

NEXT_PUBLIC_GTM_ID=GTM-CHANGEME
NEXT_PUBLIC_GA4_ID=G-CHANGEME
NEXT_PUBLIC_META_PIXEL_ID=change-me-meta-pixel-id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=change-me-tiktok-pixel-id

NEXT_PUBLIC_SENTRY_DSN=https://change-me@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=change-me-sentry-auth-token

NEXT_PUBLIC_GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+971500000000

# Kill-switches for the WebGL/motion layer (plan.md §0.2, §14) and the
# not-yet-confirmed Arabic locale (§31 Q6) — flip off instantly without a
# redeploy if either causes a Core Web Vitals regression.
NEXT_PUBLIC_ENABLE_WEBGL=true
NEXT_PUBLIC_ENABLE_AR_LOCALE=false

REVALIDATE_SECRET=change-me-revalidate-secret
INTERNAL_API_KEY=change-me-internal-api-key

# Shared ISR cache across all `web` replicas (and across deploys) — without
# this each replica regenerates pages independently and users see stale/
# inconsistent content. Required from P0; retrofitting after launch means
# debugging phantom stale pages. See plan.md §36.7.
CACHE_HANDLER_REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ============================================================================
# apps/admin
# ============================================================================
#
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_IMGPROXY_BASE_URL and NEXT_PUBLIC_SENTRY_DSN
# are also listed in plan.md §25.3's apps/admin block, but are deliberately
# NOT redeclared here: they'd be duplicate keys with the apps/web section
# above pointing at the same api/imgproxy/Sentry project, and a flat .env
# file silently applies last-value-wins to duplicate keys — a real footgun
# if someone edits one occurrence later and not the other. Both apps read
# the single definitions above.
