# Copy to .env for local dev (never committed — see .gitignore). Every
# variable below is validated by src/shared/env.ts at boot; anything
# missing or malformed crashes the process immediately (plan.md §25.3).
# Vars not listed here are optional/typed-but-unused until their owning
# module (payments, notifications, shipping, ...) is built — see env.ts.

NODE_ENV=development
TZ=UTC
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
WORKER=false
LOG_LEVEL=debug

# §36.6: must be a replica-set connection string, even in local dev.
# Ports 27018/6380 (not the defaults 27017/6379) match docker-compose.dev.yml,
# which deliberately avoids the defaults so it doesn't collide with any
# unrelated local Mongo/Redis a developer already has running — see the
# comments in docker-compose.dev.yml and the root .env.example.
MONGODB_URI=mongodb://127.0.0.1:27018/lulwah_dev?replicaSet=rs0&directConnection=true
REDIS_URL=redis://:devpassword@127.0.0.1:6380/0

# plan.md §10.1 — generate real random secrets, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
ARGON2_MEMORY=19456
ARGON2_TIME=2

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# plan.md §7.14 — catalog search sync + `GET /search`. Matches
# docker-compose.dev.yml's meilisearch service (host port 7700, same
# dev master key). Leaving MEILI_HOST unset is fine — search then always
# uses the Mongo regex fallback (see shared/env.ts's comment).
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=devMasterKeyChangeMe1234567890
MEILI_INDEX_PREFIX=dev_
