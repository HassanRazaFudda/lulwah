# plan.md §25.3 "apps/admin" — the complete env list for this app.
# Copy to .env.local for local development.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_IMGPROXY_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SENTRY_DSN=

# apps/web's own origin. Every stored media URL (/campaigns/..., /catalogue/...)
# is a path relative to apps/web's public/ folder, not this app's own — see
# lib/asset-url.ts. Defaults to apps/web's dev port when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
