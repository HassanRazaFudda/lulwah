# .env.example — apps/web
#
# Copy to .env for local development (never committed — see .gitignore).
# Next.js only loads .env files from this app's own directory, not the
# monorepo root's .env (that one is what Docker Compose injects into
# containers in production) — apps/web needs its own copy.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# In PRODUCTION, server-side (RSC) calls hit the api container directly on
# the Docker network (http://api:4000) rather than round-tripping every
# server render through Cloudflare and back (plan.md §36.7). In LOCAL DEV,
# apps/web runs on the host via `pnpm dev`/`pnpm build`, not in a container
# alongside apps/api -- there is no `api` hostname to resolve on the host,
# so this must point at the same 127.0.0.1/localhost address as
# NEXT_PUBLIC_API_URL. Getting this wrong doesn't just affect the dev
# server: `next build` prerenders ISR pages (e.g. /brands) at build time
# and needs a reachable API right then, so a wrong value here fails the
# build, not just runtime.
API_INTERNAL_URL=http://localhost:4000

NEXT_PUBLIC_IMGPROXY_BASE_URL=http://localhost:8080

# Marketing/analytics/payment keys are unused until those integrations are
# built (no discount/payment/analytics module exists yet) -- left unset.
